# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express API listens on inside Docker
PORT=5000

# "development" | "test" | "production"
# Controls logging verbosity, error detail in responses, etc.
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB connection string. In Docker this points to the compose service name.
# In production, use a connection string with auth credentials.
MONGODB_URI=mongodb://mongo:27017/bazaarhub

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origin the frontend is served from — backend allows this origin in CORS.
# In production, set to your actual domain (no trailing slash).
CORS_ORIGIN=http://localhost:5173

# ── Authentication (you implement these) ──────────────────────────────────────
# Secret used to sign JWTs. Must be long (32+ chars), random, and kept secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# How long access tokens remain valid. Short lifetimes reduce exposure.
# Format: https://github.com/vercel/ms  e.g. "15m", "1h"
JWT_ACCESS_EXPIRES=15m

# How long refresh tokens remain valid.
JWT_REFRESH_EXPIRES=7d

# Secret for signing/verifying session cookies if you use express-session.
# Same generation method as JWT_SECRET.
SESSION_SECRET=

# ── TOTP / MFA (you implement these) ─────────────────────────────────────────
# Application name shown in authenticator apps (e.g. Google Authenticator).
TOTP_ISSUER=BazaarHub

# ── Escrow / Payments (you implement these) ───────────────────────────────────
# Stripe (or equivalent) secret key — NEVER expose this to the frontend.
PAYMENT_SECRET_KEY=

# Webhook signing secret — used to verify events from the payment provider.
PAYMENT_WEBHOOK_SECRET=

# ── File / Document Storage (you implement these) ─────────────────────────────
# Where seller verification documents are stored.
# "local" stores in uploads/ (dev only). "s3" uses the vars below.
STORAGE_DRIVER=local

# AWS / S3-compatible credentials for production document storage.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Prefix all API fetch calls with this URL. Vite exposes VITE_* vars to client code.
# WARNING: anything prefixed VITE_ is bundled into the JS and visible to users.
VITE_API_URL=http://localhost:5000
