# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express API listens on inside Docker
PORT=5000

# "development" | "test" | "production"
# Controls logging verbosity, error detail in responses, etc.
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB connection string. In Docker this points to the compose service name.
# docker-compose.yml overrides this for the backend container using the
# MONGO_ROOT_USERNAME / MONGO_ROOT_PASSWORD values below — auth is required
# even though the port is loopback-only.
MONGODB_URI=mongodb://mongo:27017/bazaarhub

# Root credentials for the Mongo container itself (used by docker-compose.yml
# to set MONGO_INITDB_ROOT_USERNAME/PASSWORD and to build the backend's
# authenticated MONGODB_URI). Generate a real password before first run —
# Mongo persists these into the data volume on first init.
MONGO_ROOT_USERNAME=bazaarhub
MONGO_ROOT_PASSWORD=

# ── CAPTCHA (Cloudflare Turnstile) ────────────────────────────────────────────
# Free, privacy-friendly CAPTCHA alternative. Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Set CAPTCHA_ENABLED=false to skip during development.
CAPTCHA_ENABLED=false
CAPTCHA_SITE_KEY=1x00000000000000000000AA000000000
CAPTCHA_SECRET_KEY=1x0000000000000000000000000000000AA

# Comma-separated IPs that bypass rate limiting (e.g. monitoring tools)
IP_ALLOW_LIST=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origin the frontend is served from — backend allows this origin in CORS.
# In production, set to your actual domain (no trailing slash).
CORS_ORIGIN=http://localhost:5173

# ── Authentication (you implement these) ──────────────────────────────────────
# Server-side sessions (decision #1 — JWT was rejected: single API/single DB,
# no scaling reason to want statelessness, and revocation needs to be real).
# Secret used to sign the session cookie / derive session token hashes.
# Must be long (32+ chars), random, and kept secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# AES-256-GCM key encrypting TOTP secrets at rest (decision #4). Generate a
# 32-byte key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotate by bumping TOTP_KEY_VERSION and adding a new TOTP_ENCRYPTION_KEY_V{n}
# entry — old ciphertexts stay decryptable under their recorded key version.
TOTP_ENCRYPTION_KEY_V1=
TOTP_KEY_VERSION=1

# ── TOTP / MFA (you implement these) ─────────────────────────────────────────
# Application name shown in authenticator apps (e.g. Google Authenticator).
TOTP_ISSUER=BazaarHub

# ── Mail (password reset, registration confirmation, recovery-code-used
#    notifications — you implement the sending logic, this just wires SMTP) ──
# In Docker, docker-compose.yml overrides these to point at the mailhog
# service (127.0.0.1:8025 in your browser shows caught mail — nothing is
# ever delivered externally). For non-Docker dev, run MailHog/Maildev
# yourself and point these at it, or leave blank to point at a real
# provider's SMTP relay in production.
SMTP_HOST=localhost
SMTP_PORT=1025
# Real SMTP via Gmail. Set BOTH to send real mail (EMAIL_PASS is a Gmail App
# Password, generated at https://myaccount.google.com/apppasswords — NOT your
# account password). Leave blank to fall back to MailHog for local dev. Tests
# never use Gmail (NODE_ENV=test).
EMAIL_USER=
EMAIL_PASS=
MAIL_FROM=no-reply@bazaarhub.local

# ── Escrow / Payments (you implement these) ───────────────────────────────────
# Stripe (or equivalent) secret key — NEVER expose this to the frontend.
PAYMENT_SECRET_KEY=

# Webhook signing secret — used to verify events from the payment provider.
PAYMENT_WEBHOOK_SECRET=

# ── File / Document Storage (you implement these) ─────────────────────────────
# Where seller verification documents are stored.
# "local" stores in uploads/ (dev only). "s3" uses the vars below.
STORAGE_DRIVER=local

# AWS / S3-compatible credentials for production document storage.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Prefix all API fetch calls with this URL. Vite exposes VITE_* vars to client code.
# WARNING: anything prefixed VITE_ is bundled into the JS and visible to users.
VITE_API_URL=http://localhost:5000
